# Blockchain Configuration - DEPLOYMENT ONLY
# Copy this file to .env and fill in your values
# ⚠️ CRITICAL: NEVER commit .env to version control!

# Infura API Key for Sepolia RPC connection
# Get one free at: https://infura.io
INFURA_API_KEY=your_infura_api_key_here

# Your deployment account's private key
# ⚠️ SECURITY: Only use a testnet account with minimal ETH
# Generate: node -e "const ethers = require('ethers'); console.log(new ethers.Wallet.createRandom().privateKey)"
PRIVATE_KEY=your_private_key_here_keep_this_secret

# Network to deploy to
NETWORK=sepolia
