# Frontend Configuration - RUNTIME ONLY
# Copy this file to .env.local and fill in the contract addresses
# ⚠️ Update these after deploying contracts with: npm run deploy:sepolia

# Smart Contract Addresses (from deployment output)
VITE_MARKETPLACE_ADDRESS=0x0000000000000000000000000000000000000000
VITE_USER_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ENERGY_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
VITE_CERTIFICATE_ADDRESS=0x0000000000000000000000000000000000000000

# Oracle Configuration
# ⚠️ This should match the deployer's private key used in the contracts
# Only the Oracle (admin) can access the Oracle Dashboard
VITE_ORACLE_PRIVATE_KEY=your_oracle_private_key_here

# Network Configuration
VITE_NETWORK=sepolia
